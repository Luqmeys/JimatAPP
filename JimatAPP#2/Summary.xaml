<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JimatAPP_2.Summary"
             Title="Summary"
             BackgroundColor="#F5F5F5">

    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="0">

            <!-- ── Top Bar ── -->
            <Grid Grid.Row="0" BackgroundColor="#1A1A1A" Padding="20,16,20,0">
                <VerticalStackLayout Spacing="0">

                    <!-- Expenses / Income tabs -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="40" Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="ExpensesTabLabel"
                                   Text="EXPENSES" FontSize="16" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExpensesTabTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <BoxView x:Name="ExpensesTabUnderline"
                                     HeightRequest="2" BackgroundColor="White" WidthRequest="80"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="IncomeTabLabel"
                                   Text="INCOME" FontSize="16" FontAttributes="Bold"
                                   TextColor="#888888" HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnIncomeTabTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <BoxView x:Name="IncomeTabUnderline"
                                     HeightRequest="2" BackgroundColor="Transparent" WidthRequest="80"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Period selector pills -->
                    <Border BackgroundColor="#2A2A2A" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="6,6" Margin="0,0,0,12">
                        <Grid x:Name="PeriodSelectorGrid" ColumnDefinitions="*,*,*,*">
                            <Border x:Name="ActivePill" BackgroundColor="#1A1A1A"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    Padding="0" Grid.Column="0" Margin="2,0"/>

                            <Label x:Name="WeekPillLabel" Grid.Column="0"
                                   Text="Week" FontSize="13" FontAttributes="Bold"
                                   TextColor="#6EE7B7" HorizontalOptions="Center"
                                   VerticalOptions="Center" Padding="0,8">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWeekTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="MonthPillLabel" Grid.Column="1"
                                   Text="Month" FontSize="13" TextColor="#888888"
                                   HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMonthTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="YearPillLabel" Grid.Column="2"
                                   Text="Year" FontSize="13" TextColor="#888888"
                                   HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnYearTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="AllPillLabel" Grid.Column="3"
                                   Text="All" FontSize="13" TextColor="#888888"
                                   HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAllTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>

                    <!-- Period navigation row -->
                    <Grid ColumnDefinitions="44,*,44" Margin="0,0,0,6">
                        <Label Grid.Column="0" Text="&#8592;" FontSize="22"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPreviousPeriodTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <Label x:Name="PeriodRangeLabel" Grid.Column="1"
                               FontSize="13" TextColor="#AAAAAA"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextDecorations="Underline"/>

                        <Label x:Name="NextArrowLabel" Grid.Column="2"
                               Text="&#8594;" FontSize="22"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNextPeriodTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Back to Current pill -->
                    <Border x:Name="BackToCurrentBorder"
                            BackgroundColor="#2A3A2A" StrokeThickness="1" Stroke="#6EE7B7"
                            StrokeShape="RoundRectangle 14"
                            Padding="16,5" HorizontalOptions="Center"
                            Margin="0,0,0,14" IsVisible="False">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackToCurrentTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="&#8634;" FontSize="13" TextColor="#6EE7B7" VerticalOptions="Center"/>
                            <Label Text="Back to Current" FontSize="12" FontAttributes="Bold"
                                   TextColor="#6EE7B7" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>

            <!-- ── Scrollable Body ── -->
            <ScrollView Grid.Row="1" Padding="20,20,20,32">
                <VerticalStackLayout Spacing="20">

                    <!-- Total card -->
                    <Border BackgroundColor="#1A1A1A" StrokeThickness="0"
                            StrokeShape="RoundRectangle 24" Padding="24,20">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label x:Name="TotalCardTitle" Text="Total Expenses"
                                   FontSize="14" TextColor="#888888" HorizontalOptions="Center"/>
                            <Label x:Name="TotalAmountLabel" Text="RM 0.00"
                                   FontSize="36" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Pie Chart card -->
                    <Border BackgroundColor="#1A1A1A" StrokeThickness="0"
                            StrokeShape="RoundRectangle 24" Padding="20,20">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="By Category" FontSize="15" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>

                            <Label x:Name="EmptyChartLabel"
                                   Text="No data for this period"
                                   FontSize="14" TextColor="#666666"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,20" IsVisible="False"/>

                            <GraphicsView x:Name="PieChart"
                                          HeightRequest="220"
                                          HorizontalOptions="Fill"/>

                            <VerticalStackLayout x:Name="LegendStack" Spacing="10"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Breakdown card -->
                    <Border BackgroundColor="#1A1A1A" StrokeThickness="0"
                            StrokeShape="RoundRectangle 24" Padding="20,20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Breakdown" FontSize="15" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>

                            <Label x:Name="EmptyBreakdownLabel"
                                   Text="No data for this period"
                                   FontSize="14" TextColor="#666666"
                                   HorizontalOptions="Center"
                                   Margin="0,10,0,10" IsVisible="True"/>

                            <VerticalStackLayout x:Name="BreakdownStack" Spacing="8"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Net Balance card -->
                    <Border BackgroundColor="#1A1A1A" StrokeThickness="0"
                            StrokeShape="RoundRectangle 24" Padding="24,20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Net Balance" FontSize="15" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>

                            <BoxView HeightRequest="1" BackgroundColor="#2E2E2E"/>

                            <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                                <Label Grid.Column="0" Text="Total Income"
                                       FontSize="14" TextColor="#888888" VerticalOptions="Center"/>
                                <Label x:Name="NetIncomeLabel" Grid.Column="1"
                                       Text="RM 0.00" FontSize="15" FontAttributes="Bold"
                                       TextColor="#6EE7B7" VerticalOptions="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                                <Label Grid.Column="0" Text="Total Expenses"
                                       FontSize="14" TextColor="#888888" VerticalOptions="Center"/>
                                <Label x:Name="NetExpensesLabel" Grid.Column="1"
                                       Text="RM 0.00" FontSize="15" FontAttributes="Bold"
                                       TextColor="#FF7C7C" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="#2E2E2E"/>

                            <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                                <Label Grid.Column="0" Text="Net"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="White" VerticalOptions="Center"/>
                                <Label x:Name="NetBalanceLabel" Grid.Column="1"
                                       Text="RM 0.00" FontSize="18" FontAttributes="Bold"
                                       TextColor="#6EE7B7" VerticalOptions="Center"/>
                            </Grid>
                            <Label x:Name="NetWarningLabel"
                               Text="⚠️ Your spending exceeds your income!"
                               FontSize="13"
                               TextColor="#FF7C7C"
                               HorizontalOptions="Center"
                               IsVisible="False"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ══ BREAKDOWN DETAIL POPUP ══ -->
        <Grid x:Name="DetailPopupOverlay"
      IsVisible="False"
      BackgroundColor="#99000000">

            <!-- Tap outside to close -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDetailPopupDismiss"/>
            </Grid.GestureRecognizers>

            <Frame BackgroundColor="#1E1E1E"
           CornerRadius="28"
           Padding="24,22"
           HasShadow="True"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           WidthRequest="330"
           MaximumHeightRequest="600">

                <!-- Prevent closing when tapping inside -->
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDetailPopupCardTapped"/>
                </Frame.GestureRecognizers>

                <!-- 🔥 IMPORTANT: Use GRID instead of VerticalStackLayout -->
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
              RowSpacing="14">

                    <!-- ── Header ── -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label x:Name="DetailPopupCategoryLabel"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"/>
                            <Label x:Name="DetailPopupPeriodLabel"
                           FontSize="12"
                           TextColor="#888888"/>
                        </VerticalStackLayout>

                        <Label x:Name="DetailPopupTotalLabel"
                       Grid.Column="1"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#6EE7B7"
                       VerticalOptions="Center"/>
                    </Grid>

                    <!-- Divider -->
                    <BoxView Grid.Row="1"
                     HeightRequest="1"
                     BackgroundColor="#2E2E2E"/>

                    <!-- ── Sort Toggle ── -->
                    <Border Grid.Row="2"
                    BackgroundColor="#2E2E2E"
                    StrokeThickness="0"
                    Padding="12,6"
                    HorizontalOptions="End">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDetailSortToggled"/>
                        </Border.GestureRecognizers>

                        <Label x:Name="DetailSortToggleLabel"
                       Text="⇅  Sort: Date"
                       FontSize="12"
                       TextColor="#6EE7B7"/>
                    </Border>

                    <!-- ── Scrollable Content (flex space) ── -->
                    <ScrollView Grid.Row="3">
                        <VerticalStackLayout x:Name="DetailItemsStack"
                                     Spacing="8"/>
                    </ScrollView>

                    <!-- ── Close Button (ALWAYS VISIBLE) ── -->
                    <Frame Grid.Row="4"
                   BackgroundColor="#2E2E2E"
                   CornerRadius="20"
                   Padding="0,12"
                   HasShadow="False">

                        <Label Text="Close"
                       FontSize="15"
                       TextColor="White"
                       HorizontalOptions="Center">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDetailPopupDismiss"/>
                            </Label.GestureRecognizers>

                        </Label>
                    </Frame>

                </Grid>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
