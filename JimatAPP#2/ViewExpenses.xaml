<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JimatAPP_2.ViewExpenses"
             Title="Expenses"
             BackgroundColor="#F5F5F5">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ExpenseItemStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="#2E2E2E"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="HasShadow" Value="False"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Root Grid: page + popups layered -->
    <Grid>

        <!-- ══ LAYER 1: PAGE CONTENT ══ -->
        <Grid RowDefinitions="Auto,*,Auto" Padding="0">

            <!-- Top Navigation Bar -->
            <Grid Grid.Row="0" BackgroundColor="#1A1A1A" Padding="12,16,12,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Text="&#8592;" FontSize="22" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPreviousDayTapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="30">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Expenses" FontSize="17" FontAttributes="Bold"
                               TextColor="#6EE7B7" HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" BackgroundColor="#6EE7B7" WidthRequest="70"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Income" FontSize="17" TextColor="White" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIncomeTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <BoxView HeightRequest="2" BackgroundColor="Transparent" WidthRequest="70"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Label Grid.Column="2" Text="&#8594;" FontSize="22" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNextDayTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Scrollable list -->
            <ScrollView Grid.Row="1" Padding="20,16">
                <VerticalStackLayout Spacing="8">

                    <Label x:Name="DateLabel" FontSize="14" TextColor="#888888"
                           HorizontalOptions="Center" TextDecorations="Underline" Margin="0,0,0,4"/>

                    <Label x:Name="DayHeadingLabel" Text="Today's Expenses :"
                           FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A" Margin="0,0,0,8"/>

                    <Label x:Name="EmptyLabel" Text="No expenses for this day"
                           FontSize="16" TextColor="#AAAAAA"
                           HorizontalOptions="Center" Margin="0,20,0,0" IsVisible="True"/>

                    <VerticalStackLayout x:Name="ExpensesList" Spacing="4"/>

                    <Frame x:Name="AddButtonFrame"
                           BackgroundColor="Transparent" BorderColor="#2E2E2E"
                           CornerRadius="22" Padding="0" HasShadow="False"
                           WidthRequest="44" HeightRequest="44"
                           HorizontalOptions="Center" Margin="0,8,0,0">
                        <Label Text="+" FontSize="28" TextColor="#1A1A1A"
                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddExpenseTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Frame>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Bottom bar -->
            <VerticalStackLayout Grid.Row="2" Padding="20,16,20,32"
                                 BackgroundColor="#F5F5F5" Spacing="10">

                <Label x:Name="TotalHeadingLabel" Text="Today's Total:"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="#1A1A1A" HorizontalOptions="Center"/>

                <Frame BackgroundColor="#6EE7B7" CornerRadius="24"
                       Padding="40,14" HasShadow="False" HorizontalOptions="Center">
                    <Label x:Name="TotalLabel" Text="RM 0.00"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="#1A1A1A" HorizontalOptions="Center"/>
                </Frame>

                <Frame BackgroundColor="#1A1A1A" CornerRadius="24"
                       Padding="32,12" HasShadow="False"
                       HorizontalOptions="Center" Margin="0,2,0,0">
                    <Label Text="View Net Balance" FontSize="15" FontAttributes="Bold"
                           TextColor="#6EE7B7" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNetBalanceTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Frame>

            </VerticalStackLayout>
        </Grid>

        <!-- ══ LAYER 2: ITEM DETAIL POPUP ══ -->
        <Grid x:Name="DetailPopupOverlay" IsVisible="False" BackgroundColor="#99000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDetailPopupDismiss"/>
            </Grid.GestureRecognizers>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="28" Padding="28,26"
                   HasShadow="True" HorizontalOptions="Center" VerticalOptions="Center"
                   WidthRequest="310">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPopupCardTapped"/>
                </Frame.GestureRecognizers>

                <VerticalStackLayout Spacing="18">

                    <!-- Header chip: category -->
                    <Frame x:Name="DetailCategoryChip"
                           BackgroundColor="#2E2E2E" CornerRadius="14"
                           Padding="18,6" HasShadow="False" HorizontalOptions="Center">
                        <Label x:Name="DetailCategoryLabel"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#6EE7B7" HorizontalOptions="Center"/>
                    </Frame>

                    <!-- Amount (large) -->
                    <Label x:Name="DetailAmountLabel"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>

                    <BoxView HeightRequest="1" BackgroundColor="#2E2E2E"/>

                    <!-- Date row -->
                    <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                        <Label Grid.Column="0" Text="Date" FontSize="13"
                               TextColor="#888888" VerticalOptions="Center"/>
                        <Label x:Name="DetailDateLabel" Grid.Column="1"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Description row -->
                    <VerticalStackLayout Spacing="6" Padding="4,0">
                        <Label Text="Description" FontSize="13" TextColor="#888888"/>
                        <Frame BackgroundColor="#2A2A2A" CornerRadius="12"
                               Padding="14,10" HasShadow="False">
                            <Label x:Name="DetailDescriptionLabel"
                                   FontSize="14" TextColor="White"
                                   LineBreakMode="WordWrap"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Edit + Close buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">

                        <Frame Grid.Column="0" BackgroundColor="#2E2E2E"
                               CornerRadius="20" Padding="0,12" HasShadow="False">
                            <Label Text="Edit" FontSize="15" TextColor="White"
                                   HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDetailEditTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Frame>

                        <Frame Grid.Column="1" BackgroundColor="#2E2E2E"
                               CornerRadius="20" Padding="0,12" HasShadow="False">
                            <Label Text="Close" FontSize="15" TextColor="White"
                                   HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDetailPopupDismiss"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Frame>

                    </Grid>

                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- ══ LAYER 3: NET BALANCE POPUP ══ -->
        <Grid x:Name="PopupOverlay" IsVisible="False" BackgroundColor="#99000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPopupDismiss"/>
            </Grid.GestureRecognizers>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="28" Padding="28,26"
                   HasShadow="True" HorizontalOptions="Center" VerticalOptions="Center"
                   WidthRequest="310">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPopupCardTapped"/>
                </Frame.GestureRecognizers>

                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="PopupDateLabel" FontSize="12" TextColor="#666666"
                               HorizontalOptions="Center"/>
                        <Label Text="Net Balance" FontSize="22" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#2E2E2E"/>

                    <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                        <Label Grid.Column="0" Text="Total Income" FontSize="14"
                               TextColor="#888888" VerticalOptions="Center"/>
                        <Label x:Name="PopupIncomeLabel" Grid.Column="1"
                               Text="RM 0.00" FontSize="16" FontAttributes="Bold"
                               TextColor="#6EE7B7" VerticalOptions="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                        <Label Grid.Column="0" Text="Total Expenses" FontSize="14"
                               TextColor="#888888" VerticalOptions="Center"/>
                        <Label x:Name="PopupExpensesLabel" Grid.Column="1"
                               Text="RM 0.00" FontSize="16" FontAttributes="Bold"
                               TextColor="#FF7C7C" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#2E2E2E"/>

                    <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                        <Label Grid.Column="0" Text="Net Balance" FontSize="16"
                               FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                        <Label x:Name="PopupNetLabel" Grid.Column="1"
                               Text="RM 0.00" FontSize="18" FontAttributes="Bold"
                               TextColor="#6EE7B7" VerticalOptions="Center"/>
                    </Grid>

                    <Frame BackgroundColor="#2E2E2E" CornerRadius="20"
                           Padding="0,12" HasShadow="False" Margin="0,6,0,0">
                        <Label Text="Close" FontSize="15" TextColor="White"
                               HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPopupDismiss"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Frame>

                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
