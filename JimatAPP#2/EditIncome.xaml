<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JimatAPP_2.EditIncome"
             Title="Edit Income"
             BackgroundColor="#1A1A1A">

    <ScrollView>
        <VerticalStackLayout Padding="28,32,28,40" Spacing="24">

            <Label Text="Edit Income"
                   FontSize="22" FontAttributes="Bold"
                   TextColor="White" HorizontalOptions="Center"
                   Margin="0,0,0,8"/>

            <!-- Date -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Date" FontSize="16" TextColor="White" HorizontalOptions="Center"/>
                <Border BackgroundColor="#2E2E2E" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <DatePicker x:Name="IncomeDatePicker" Grid.Column="0"
                                    TextColor="White" BackgroundColor="Transparent"
                                    Format="M/d/yyyy" FontSize="15"/>
                        <Label Grid.Column="1" Text="📅" FontSize="20" VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Amount -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Amount :" FontSize="16" TextColor="White" HorizontalOptions="Center"/>
                <Border BackgroundColor="#2E2E2E" StrokeThickness="0"
                        StrokeShape="RoundRectangle 24" Padding="20,14">
                    <Entry x:Name="AmountEntry" Placeholder="0"
                           PlaceholderColor="#888888" TextColor="White"
                           BackgroundColor="Transparent" FontSize="18"
                           FontAttributes="Bold" Keyboard="Numeric"
                           HorizontalTextAlignment="Center"/>
                </Border>
                <Label Text="Enter amount in RM" FontSize="12"
                       TextColor="#888888" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Category -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Category :" FontSize="16" TextColor="White" HorizontalOptions="Center"/>
                <Border BackgroundColor="#2E2E2E" StrokeThickness="0"
                        StrokeShape="RoundRectangle 24" Padding="20,4">
                    <Picker x:Name="CategoryPicker" TextColor="White"
                            BackgroundColor="Transparent" FontSize="16"
                            FontAttributes="Bold" Title="Select category"
                            TitleColor="#888888">
                        <Picker.Items>
                            <x:String>Paycheck</x:String>
                            <x:String>Gift</x:String>
                            <x:String>Others</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <!-- Description -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Description :" FontSize="16" TextColor="White" HorizontalOptions="Center"/>
                <Border BackgroundColor="#2E2E2E" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" Padding="20,12">
                    <Editor x:Name="DescriptionEditor"
                            Placeholder="Add a note (optional)"
                            PlaceholderColor="#888888" TextColor="White"
                            BackgroundColor="Transparent" FontSize="15"
                            AutoSize="TextChanges" MinimumHeightRequest="72"/>
                </Border>
            </VerticalStackLayout>

            <!-- Save -->
            <Border BackgroundColor="#6EE7B7" StrokeThickness="0"
                    StrokeShape="RoundRectangle 28" Padding="0,14"
                    Margin="20,16,20,0">
                <Label Text="Save" FontSize="18" FontAttributes="Bold"
                       TextColor="#1A1A1A" HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Border>

            <!-- Delete -->
            <Border BackgroundColor="#3A1A1A" StrokeThickness="0"
                    StrokeShape="RoundRectangle 28" Padding="0,14"
                    Margin="20,0,20,0">
                <Label Text="Delete Income" FontSize="18" FontAttributes="Bold"
                       TextColor="#FF6B6B" HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
