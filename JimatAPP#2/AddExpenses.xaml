<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JimatAPP_2.AddExpenses"
             Title="Add Expenses"
             BackgroundColor="#1A1A1A">

    <Grid>
        <!-- ── Main form ── -->
        <ScrollView>
            <VerticalStackLayout Padding="28,32,28,40" Spacing="24">

                <Label Text="Add Expenses"
                       FontSize="22" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center"
                       Margin="0,0,0,8"/>

                <!-- Date -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Date" FontSize="16" TextColor="White" HorizontalOptions="Center"/>
                    <Border BackgroundColor="#2E2E2E" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <DatePicker x:Name="ExpenseDatePicker" Grid.Column="0"
                                        TextColor="White" BackgroundColor="Transparent"
                                        Format="M/d/yyyy" FontSize="15"/>
                            <Label Grid.Column="1" Text="📅" FontSize="20" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Amount -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Amount :" FontSize="16" TextColor="White" HorizontalOptions="Center"/>
                    <Border BackgroundColor="#2E2E2E" StrokeThickness="0"
                            StrokeShape="RoundRectangle 24" Padding="20,14">
                        <Entry x:Name="AmountEntry" Placeholder="0"
                               PlaceholderColor="#888888" TextColor="White"
                               BackgroundColor="Transparent" FontSize="18"
                               FontAttributes="Bold" Keyboard="Numeric"
                               HorizontalTextAlignment="Center"/>
                    </Border>
                    <Label Text="Enter amount in RM" FontSize="12"
                           TextColor="#888888" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Category -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category :" FontSize="16" TextColor="White" HorizontalOptions="Center"/>
                    <Border BackgroundColor="#2E2E2E" StrokeThickness="0"
                            StrokeShape="RoundRectangle 24" Padding="20,4">
                        <Picker x:Name="CategoryPicker" TextColor="White"
                                BackgroundColor="Transparent" FontSize="16"
                                FontAttributes="Bold" Title="Select category"
                                TitleColor="#888888">
                            <Picker.Items>
                                <x:String>Food</x:String>
                                <x:String>Needs</x:String>
                                <x:String>Transport</x:String>
                                <x:String>Entertainment</x:String>
                                <x:String>Health</x:String>
                                <x:String>Shopping</x:String>
                                <x:String>Others</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Description :" FontSize="16" TextColor="White" HorizontalOptions="Center"/>
                    <Border BackgroundColor="#2E2E2E" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20" Padding="20,12">
                        <Editor x:Name="DescriptionEditor"
                                Placeholder="Add a note (optional)"
                                PlaceholderColor="#888888" TextColor="White"
                                BackgroundColor="Transparent" FontSize="15"
                                AutoSize="TextChanges" MinimumHeightRequest="72"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Done -->
                <Border BackgroundColor="#6EE7B7" StrokeThickness="0"
                        StrokeShape="RoundRectangle 28" Padding="0,14"
                        Margin="20,16,20,0">
                    <Label Text="Done" FontSize="18" FontAttributes="Bold"
                           TextColor="#1A1A1A" HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDoneTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══ OVERSPENDING WARNING POPUP ══ -->
        <Grid x:Name="OverspendingPopup" IsVisible="False" BackgroundColor="#CC000000">

            <Frame BackgroundColor="#1E1E1E" CornerRadius="28" Padding="28,26"
                   HasShadow="True" HorizontalOptions="Center" VerticalOptions="Center"
                   WidthRequest="320">
                <VerticalStackLayout Spacing="18">

                    <!-- Warning icon + title -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="⚠️" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="Careful!" FontSize="22" FontAttributes="Bold"
                               TextColor="#FBBF24" HorizontalOptions="Center"/>
                        <Label Text="You're spending more than you're making this month."
                               FontSize="14" TextColor="#AAAAAA"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#2E2E2E"/>

                    <!-- Stats -->
                    <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                        <Label Grid.Column="0" Text="This month's income"
                               FontSize="13" TextColor="#888888" VerticalOptions="Center"/>
                        <Label x:Name="PopupIncomeLabel" Grid.Column="1"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#6EE7B7" VerticalOptions="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                        <Label Grid.Column="0" Text="This month's expenses"
                               FontSize="13" TextColor="#888888" VerticalOptions="Center"/>
                        <Label x:Name="PopupExpensesLabel" Grid.Column="1"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#FF7C7C" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#2E2E2E"/>

                    <!-- "I understand" checkbox -->
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border x:Name="CheckboxBorder"
                                BackgroundColor="#2E2E2E" StrokeThickness="1.5" Stroke="#888888"
                                StrokeShape="RoundRectangle 6"
                                WidthRequest="24" HeightRequest="24">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCheckboxTapped"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="CheckboxTick" Text="✓" FontSize="14"
                                   TextColor="#6EE7B7" HorizontalOptions="Center"
                                   VerticalOptions="Center" IsVisible="False"/>
                        </Border>
                        <Label Text="Don't warn me again today" FontSize="14"
                               TextColor="White" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCheckboxTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Proceed button -->
                    <Border BackgroundColor="#6EE7B7" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20" Padding="0,13">
                        <Label Text="I Understand, Proceed" FontSize="15" FontAttributes="Bold"
                               TextColor="#1A1A1A" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOverspendingProceed"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                    <!-- Cancel -->
                    <Border BackgroundColor="#2E2E2E" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20" Padding="0,13">
                        <Label Text="Cancel" FontSize="15" TextColor="White"
                               HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOverspendingCancel"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
