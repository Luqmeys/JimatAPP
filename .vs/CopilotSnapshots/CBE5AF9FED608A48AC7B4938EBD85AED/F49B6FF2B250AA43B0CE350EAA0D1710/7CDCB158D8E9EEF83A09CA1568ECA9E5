    // ── Pie chart drawable — fixed arc drawing ────────────────────────────────
    public class PieChartDrawable : IDrawable
    {
        public List<(string Label, decimal Value, Color Slice)> Segments { get; set; } = new();

        public void Draw(ICanvas canvas, RectF dirtyRect)
        {
            if (Segments == null || Segments.Count == 0) return;

            float cx = dirtyRect.Width / 2f;
            float cy = dirtyRect.Height / 2f;
            float radius = Math.Min(cx, cy) - 10f;
            if (radius <= 0) return;

            decimal total = Segments.Sum(s => s.Value);
            if (total <= 0) return;

            float startDeg = -90f;

            foreach (var seg in Segments)
            {
                float sweep = (float)(seg.Value / total) * 360f;
                float endDeg = startDeg + sweep;

                canvas.FillColor = seg.Slice;
                var path = new PathF();
                path.MoveTo(cx, cy);

                int steps = Math.Max(3, (int)(sweep / 2));
                for (int s = 0; s <= steps; s++)
                {
                    float angle = startDeg + sweep * s / steps;
                    float rad = angle * MathF.PI / 180f;
                    path.LineTo(cx + radius * MathF.Cos(rad),
                                cy + radius * MathF.Sin(rad));
                }

                path.Close();
                canvas.FillPath(path);
                startDeg = endDeg;
            }

            // Donut hole
            canvas.FillColor = Color.FromArgb("#1A1A1A");
            canvas.FillCircle(cx, cy, radius * 0.52f);
        }
    }

    // ── Summary page ─────────────────────────────────────────────────────────
