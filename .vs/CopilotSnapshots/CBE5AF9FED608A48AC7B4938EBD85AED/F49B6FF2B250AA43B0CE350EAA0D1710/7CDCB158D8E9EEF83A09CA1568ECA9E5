            ExpensesTabLabel.TextColor = isExp ? Colors.White : MutedText;
            ExpensesTabUnderline.BackgroundColor = isExp ? Colors.White : Colors.Transparent;
            IncomeTabLabel.TextColor = !isExp ? Colors.White : MutedText;
