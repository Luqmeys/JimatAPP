            if (_period == Period.All) return;
            _period = Period.All; _periodOffset = 0; UpdatePillUI(); Refresh();
        }

        private void UpdatePillUI()
        {
            WeekPillLabel.TextColor = MutedText;
            MonthPillLabel.TextColor = MutedText;
            YearPillLabel.TextColor = MutedText;
            AllPillLabel.TextColor = MutedText;

            switch (_period)
            {
                case Period.Week: WeekPillLabel.TextColor = GreenAccent; break;
                case Period.Month: MonthPillLabel.TextColor = GreenAccent; break;
                case Period.Year: YearPillLabel.TextColor = GreenAccent; break;
                default: AllPillLabel.TextColor = GreenAccent; break;
            }

            Grid.SetColumn(ActivePill, _period switch
            {
                Period.Week => 0,
                Period.Month => 1,
                Period.Year => 2,
